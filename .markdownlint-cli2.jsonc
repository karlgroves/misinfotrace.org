{
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD025": true,
    "MD029": { "style": "ordered" },
    "MD033": false,
    "MD040": true,
    "MD041": false,
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/", "_site/", "test-results/", "playwright-report/"],
}
